serial: amba-pl011: a switch for kernel messages on the console port

On the Digium phones UART A is both the console and the electronic hook
switch (EHS) headset adapter's port, and boot2 always passes
console=ttyAMA0.  The console stays registered, but writes nothing (the
early console included) until amba_pl011.console_output is set, on the
command line or through /sys/module/amba_pl011/parameters/console_output.
The pstore console is not affected, unlike with a lowered console log
level.  On other platforms the default is on.

--- a/drivers/tty/serial/amba-pl011.c
+++ b/drivers/tty/serial/amba-pl011.c
@@ -2666,12 +2666,28 @@
 	return -ENODEV;
 }
 
+/*
+ * Whether kernel messages are written to the port.  On the Digium phones
+ * the console UART is also the electronic hook switch (EHS) headset
+ * adapter's port, and the boot loader always passes console=ttyAMA0, so the
+ * console is registered but stays silent until user space turns it on
+ * (/sys/module/amba_pl011/parameters/console_output), or the command line
+ * has amba_pl011.console_output=1.  The other consoles (pstore) are not
+ * affected, which lowering the console log level would do.
+ */
+static bool pl011_console_output = !IS_ENABLED(CONFIG_ARCH_BCMRING);
+module_param_named(console_output, pl011_console_output, bool, 0644);
+MODULE_PARM_DESC(console_output, "Write kernel messages to the console port");
+
 static void
 pl011_console_write_atomic(struct console *co, struct nbcon_write_context *wctxt)
 {
 	struct uart_amba_port *uap = amba_ports[co->index];
 	unsigned int old_cr = 0;
 
+	if (!READ_ONCE(pl011_console_output))
+		return;
+
 	if (!nbcon_enter_unsafe(wctxt))
 		return;
 
@@ -2700,6 +2716,9 @@
 	struct uart_amba_port *uap = amba_ports[co->index];
 	unsigned int old_cr = 0;
 
+	if (!READ_ONCE(pl011_console_output))
+		return;
+
 	if (!nbcon_enter_unsafe(wctxt))
 		return;
 
@@ -2796,6 +2815,9 @@
 {
 	struct earlycon_device *dev = con->data;
 
+	if (!READ_ONCE(pl011_console_output))
+		return;
+
 	uart_console_write(&dev->port, s, n, pl011_putc);
 }
 
