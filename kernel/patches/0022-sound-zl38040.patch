ASoC: codecs: add the Microsemi ZL38040 voice processor

Kconfig and Makefile entries for sound/soc/codecs/zl38040.c, the codec of
the Digium D80.

--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -369,6 +369,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_WSA883X
 	imply SND_SOC_WSA884X
 	imply SND_SOC_WSA885X
+	imply SND_SOC_ZL38040
 	imply SND_SOC_ZL38060
 	help
 	  Normally ASoC codec drivers are only built if a machine driver which
@@ -2796,6 +2797,17 @@ config SND_SOC_WSA885X
 	  map and exposes the DAI and mixer controls used by Qualcomm
 	  audio machine drivers.
 
+config SND_SOC_ZL38040
+	tristate "Microsemi ZL38040 voice processor (Digium D80)"
+	depends on SPI_MASTER
+	depends on GPIOLIB
+	select REGMAP
+	help
+	  Support for the Microsemi ZL38040 voice processor with acoustic
+	  echo cancellation, as used in the Digium D80 desk phone: firmware
+	  boot, the speaker, handset, headset, and Bluetooth call paths, and
+	  a DAI on the chip's TDM-B port.
+
 config SND_SOC_ZL38060
 	tristate "Microsemi ZL38060 Connected Home Audio Processor"
 	depends on SPI_MASTER
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -429,6 +429,7 @@ snd-soc-wsa881x-y := wsa881x.o
 snd-soc-wsa883x-y := wsa883x.o
 snd-soc-wsa884x-y := wsa884x.o
 snd-soc-wsa885x-y := wsa885x.o
+snd-soc-zl38040-y := zl38040.o
 snd-soc-zl38060-y := zl38060.o
 # Amp
 snd-soc-max9877-y := max9877.o
@@ -882,6 +883,7 @@ obj-$(CONFIG_SND_SOC_WSA881X)	+= snd-soc-wsa881x.o
 obj-$(CONFIG_SND_SOC_WSA883X)	+= snd-soc-wsa883x.o
 obj-$(CONFIG_SND_SOC_WSA884X)	+= snd-soc-wsa884x.o
 obj-$(CONFIG_SND_SOC_WSA885X)	+= snd-soc-wsa885x.o
+obj-$(CONFIG_SND_SOC_ZL38040)	+= snd-soc-zl38040.o
 obj-$(CONFIG_SND_SOC_ZL38060)	+= snd-soc-zl38060.o
 
 # Amp
