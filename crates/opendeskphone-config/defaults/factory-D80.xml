    <setting id="phone_model" value="D80" conflict="freeze"/>
    <setting id="max_accounts" value="6" conflict="freeze"/>
    <setting id="width" value="800" conflict="freeze"/>
    <setting id="height" value="1280" conflict="freeze"/>
    <setting id="desi_strip_type" value="none" conflict="freeze"/>
