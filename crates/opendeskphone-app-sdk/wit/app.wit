/// The Open Desk Phone application interface.
///
/// An app is a WebAssembly component targeting the `app` world.  The host
/// calls `guest.start` once and then `guest.handle` for every event; all
/// host services that take time (PBX requests, HTTP, timers) return an id
/// at once and deliver their result later as an event, so an app never
/// blocks the phone.  An app is given the interfaces its component
/// imports, and no others.
package opendeskphone:app@3.0.0;

interface types {
  /// A widget handle.  Handle 0 is the app's root window (the app content
  /// area of the skin, e.g., 480x243 on color models and 800x1160 on the
  /// touchscreen).
  type widget = u32;
  type timer-id = u32;
  type request-id = u32;
  type call-id = u32;

  /// The kinds of screen.  `touch` is the touchscreen of a phone that
  /// has no keys (the D80): the user touches what is on the screen.
  enum skin { small-gray, large-gray, color, touch }

  record size { width: u16, height: u16 }

  /// Sizes an app lays out with: the content area and the stock text
  /// metrics of the skin.
  record metrics {
    skin: skin,
    /// App content area (240x102, 320x140, 480x243, or 800x1160).
    width: u16,
    height: u16,
    line-height: u16,
    title-height: u16,
    title-offset: u16,
    row-height: u16,
    scroll-bar-width: u16,
    color: bool,
    /// The phone has keys: a dial pad, arrows, and keys under the
    /// display.  A phone without (the `touch` skin) is used by touch
    /// alone: no `event.key` comes from a key there, and what an app
    /// does with a key it must offer on the screen (a list, a softkey,
    /// or a widget that takes touches, `ui.claim-touch`).
    keys: bool,
    /// The width of the back button, which the phone draws over the
    /// top-left corner of the window where there are no keys, as high
    /// as `title-height`: touching it is the key `cancel`.  A title
    /// begins to the right of it.  0 where the phone has keys.
    back-width: u16,
  }
  record rect { x: s16, y: s16, width: u16, height: u16 }

  enum widget-kind { group, text, text-list, scroll, input, image }

  enum align { left, center, right }
  enum font { small, normal, large, bold, title }
  enum input-mode { text, numeric, dial, password, pin }

  /// The phone's icons: the one-color icons, and the color icons of the
  /// apps (`app-...`).
  enum icon {
    alarm, apps, backspace, brightness, calllog, clock, conference,
    contacts, desk, dnd, down, error, forward, handset, headset, hold,
    info, left, lock, more, mute, net-down, network, ok, page, park,
    phone-in, phone-missed, phone-out, phone-unregistered, phone, presence,
    registered, right, ring, settings, speaker, transfer, unregistered, up,
    update, voicemail, warning,
    app-alarms, app-app, app-boxpusher, app-calendar, app-calllog,
    app-contacts, app-desksparrow, app-diagnostics, app-forward,
    app-hotdesking, app-info, app-lightup, app-network, app-paging,
    app-parking, app-queues, app-settings, app-status, app-update,
    app-voicemail,
  }

  /// A picture to show: one of the phone's icons, or a picture the app
  /// defined (`ui.define-image`), by its name.
  variant image {
    icon(icon),
    picture(string),
  }

  record list-item {
    /// Main text.
    text: string,
    /// Secondary text at the right edge (may be empty).
    detail: string,
    icon: option<image>,
  }

  /// A key of the phone.  No model has every key.
  variant key {
    /// The dial pad: 0 to 9.
    digit(u8),
    star,
    pound,
    up,
    down,
    left,
    right,
    /// The check-mark key.
    select,
    /// The X key.
    cancel,
    volume-up,
    volume-down,
    /// The four keys below the display, 1 to 4 from the left.
    softkey(u8),
    /// The line keys, from 1 at the top.
    line(u8),
    /// The rapid-dial keys, from 1 at the top.
    blf(u8),
    mute,
    speaker,
    headset,
    hold,
    transfer,
    redial,
    /// Voicemail (`Msgs`).
    messages,
    conference,
    info,
    /// The page keys of the rapid-dial keys.
    blf-page-left,
    blf-page-right,
    status,
    contacts,
    apps,
    menu,
    /// A key of an expansion module.
    expansion(expansion-key),
    /// A key without a function of its own, by its key code.
    other(u16),
  }

  record expansion-key {
    /// From 0.
    module: u8,
    /// From 0.
    key: u8,
  }

  enum phone-model { d40, d45, d50, d60, d62, d65, d70, d80 }

  record softkey {
    /// App-chosen identifier reported in `event.softkey`.
    id: u32,
    label: string,
  }

  variant widget-event {
    /// The highlighted row of a list changed.
    highlighted(u32),
    /// Select was pressed on a list row.
    activated(u32),
    /// The text of an input changed.
    changed(string),
    /// Select was pressed in an input.
    submitted(string),
  }

  /// A place in a widget, in pixels from its top-left corner.  A finger
  /// that leaves the widget is at a place outside it (also negative).
  record point { x: s16, y: s16 }

  /// What a finger did on a widget that takes touches
  /// (`ui.claim-touch`).
  variant touch {
    /// It came down and went up again in one place: that place.
    tap(point),
    /// It moves, having come down: where it came down, and where it is
    /// now.  Arrives for every movement.
    drag(tuple<point, point>),
    /// It was lifted after a `drag`: where it came down, and where it
    /// was lifted.
    drag-end(tuple<point, point>),
  }

  variant error {
    /// Bad argument (e.g., a number that cannot be dialed).
    invalid(string),
    /// The phone could not do what was asked, or would not; the text says
    /// why.
    failed(string),
  }

  record header { name: string, value: string }

  record http-response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  /// A presence state of the PBX (Asterisk's).
  enum pbx-presence-state { not-set, unavailable, available, away, xa, chat, dnd }

  /// The presence the phone's user has on the PBX (`pbx.presence-info`).
  record pbx-presence {
    /// The option that is set (`pbx-presence-option.id`).
    option-id: u32,
    state: pbx-presence-state,
    /// The option's sub-state (may be empty).
    sub-state: string,
    /// The user's message (may be empty).
    message: string,
  }

  /// A presence the user can choose (`pbx.presence-options`).
  record pbx-presence-option {
    id: u32,
    state: pbx-presence-state,
    /// May be empty.
    sub-state: string,
    /// The user made the option; otherwise the PBX has it.
    by-user: bool,
    /// The option is set.
    active: bool,
  }

  /// A call waiting in a parking lot.
  record parked-call {
    /// The parking space: the number that takes the call.
    space: string,
    caller-name: string,
    caller-number: string,
    /// Seconds since the call was parked.
    duration: u32,
  }

  record parking-lot {
    name: string,
    /// The lot's first and last parking spaces.
    first-space: string,
    last-space: string,
    /// Seconds a call stays parked before it rings back.
    timeout: u32,
    /// The calls parked in a lot the phone may see (all lots, or those
    /// of the phone's parking applications).
    calls: list<parked-call>,
  }

  /// What the phone's user is in a call queue.
  enum queue-membership {
    /// A member who logged in.
    logged-in,
    /// A member who does not log in or out.
    permanent,
    /// A member who is logged out.
    logged-out,
    /// Not a member: the user manages the queue.
    manager,
  }

  /// A call queue of the phone's queue applications (`pbx.queues`).
  record call-queue {
    /// Identifies the queue in the other queue functions.
    id: string,
    name: string,
    membership: queue-membership,
    paused: bool,
    /// The counts the PBX lets the phone see, if any.
    members: option<u32>,
    members-logged-in: option<u32>,
    callers-waiting: option<u32>,
  }

  record queue-member {
    name: string,
    membership: queue-membership,
    /// Seconds on the call the member has, if any.
    on-call: option<u32>,
  }

  record queue-caller {
    name: string,
    number: string,
    /// 1 is the next to be answered.
    position: u32,
    /// Seconds waited.
    waiting: u32,
  }

  /// Today's figures of a call queue (`pbx.queue-status`).
  record queue-status {
    id: string,
    name: string,
    members: u32,
    /// The members logged in and not paused.
    members-logged-in: u32,
    members-on-call: u32,
    callers-waiting: u32,
    /// Calls today: completed and abandoned.
    calls: u32,
    completed-calls: u32,
    abandoned-calls: u32,
    /// The members and the waiting callers, if the PBX lets the phone see
    /// them.
    member-list: list<queue-member>,
    caller-list: list<queue-caller>,
  }

  /// How `pbx.voicemail-messages` orders the messages.
  enum voicemail-sort { date, id }

  record voicemail-message {
    /// Identifies the message in the other voicemail functions.
    id: string,
    caller-name: string,
    caller-number: string,
    /// When the message was left, in seconds since the Unix epoch; 0 when
    /// the PBX's date is not one the phone can read.
    date: u64,
    /// Seconds.
    duration: u32,
    read: bool,
  }

  /// One page of a voicemail folder's messages.
  record voicemail-page {
    folder: string,
    /// The page (from 1), and how many pages there are.
    page: u32,
    pages: u32,
    /// The messages in the folder.
    total: u32,
    messages: list<voicemail-message>,
  }

  record voicemail-folder {
    /// What the voicemail functions take as a folder.
    name: string,
    /// The messages in the folder.
    count: u32,
  }

  /// What a `pbx` request ended in.
  variant pbx-result {
    /// The request was carried out.
    done,
    presence(pbx-presence),
    presence-options(list<pbx-presence-option>),
    parking-lots(list<parking-lot>),
    queues(list<call-queue>),
    queue-status(queue-status),
    voicemail(voicemail-page),
    voicemail-folders(list<voicemail-folder>),
  }

  /// The PBX's refusal of a request.
  record pbx-server-error {
    /// The DPMA error code, e.g., 27168: the account is not permitted to
    /// do this.
    code: u32,
    message: string,
  }

  variant pbx-error {
    /// The server answered with an error.
    server(pbx-server-error),
    /// The request did not reach the server, or the server's answer is
    /// not the method's; the text says why.
    transport(string),
  }

  /// Where an app's keys are (`storage`).
  enum storage-location {
    /// On the phone.
    local,
    /// On the PBX, the keys of the phone's user: the same on every phone
    /// the user has, and kept when a phone is reset.
    pbx-private,
    /// On the PBX, the keys that the app's copies on all phones share.
    pbx-shared,
  }

  /// The phone's user, as the PBX knows them.
  record pbx-user {
    /// Identifies the user; unlike the name, it does not change.
    id: string,
    /// The name to show.
    name: string,
    /// The user's extension (may be empty).
    extension: string,
  }

  /// One key of the app's store.
  record storage-entry {
    key: string,
    value: list<u8>,
    /// Changes with every write of the key, and is never 0 and never a
    /// version the key had before.  `storage.set` and `remove` take it
    /// as `expect`.
    version: u64,
    /// When the key was set: seconds since the Unix epoch, by the PBX's
    /// clock (the phone's for `local`).
    modified: u64,
    /// The user who set it (`pbx-user.id`); empty for `local`.
    author-id: string,
    /// That user's name when they set it; empty for `local`.
    author-name: string,
  }

  /// The outcome of a `storage` request.
  variant storage-outcome {
    /// `get`: the entry, if the key is set.
    entry(option<storage-entry>),
    /// `list`: entries in the order of their keys, and whether there are
    /// more after the last of them.
    entries(tuple<list<storage-entry>, bool>),
    /// `set`: the entry as the store now has it.
    stored(storage-entry),
    /// `remove`: the key is not set (now, or it never was).
    removed,
    /// `set` or `remove` with `expect`: the key is not as expected, and
    /// nothing was changed.  This is the entry it has now, if it is set.
    conflict(option<storage-entry>),
    /// The store could not be reached: for a PBX location, the phone has
    /// no session with the PBX, or the PBX did not answer (it may keep no
    /// app data); for `local`, the phone could not read or write its
    /// flash.  The text says why.  Nothing is kept to send later.  A
    /// `set` or `remove` that ends so may still have been done.
    unreachable(string),
    /// The store refused the request: a key that cannot be one, a value
    /// over the limit, or a store that is full.  The text says which.
    refused(string),
  }

  /// What a `storage` request returns.
  variant storage-reply {
    /// `local`: the outcome.
    done(storage-outcome),
    /// `pbx-private` and `pbx-shared`: the outcome arrives as
    /// `event.storage` with this id.
    pending(request-id),
  }

  /// A change to the app's keys on the PBX made from another phone.
  record storage-change {
    location: storage-location,
    /// The key that was set or removed.
    key: string,
  }

  enum call-state {
    dialing, proceeding, ringback, ringing, active, held, transferring, ended,
  }

  record call-info {
    id: call-id,
    /// Account slot (0-based).
    account: u8,
    incoming: bool,
    state: call-state,
    remote-name: string,
    remote-number: string,
    /// Seconds since the call was answered (0 before).
    duration: u32,
  }

  record account-info {
    slot: u8,
    /// Stock `account id` attribute.
    id: string,
    label: string,
    user: string,
    server: string,
    registered: bool,
  }

  record mwi { account: u8, new-messages: u32, old-messages: u32 }

  enum presence-status { available, chat, away, dnd, xa, unavailable, unknown }

  /// The state of a contact's line.
  enum line-state {
    idle,
    ringing,
    busy,
    hold,
    /// One call held, another ringing.
    hold-ringing,
    /// No device registered.
    unavailable,
    unknown,
  }

  record presence {
    /// Subscription target (extension or URI).
    target: string,
    status: presence-status,
    text: string,
    line-state: line-state,
  }

  /// The SIP method that carried a push.
  enum push-method { message, invite, info }

  record push {
    /// Event name: the last of `X-Digium-Event-Name`, `X-Event-Name`,
    /// and `X-Event-Type` the request carries.
    name: string,
    /// `X-Event-Type` (may be empty).
    kind: string,
    /// `X-Event-Data` or the body, as text (JSON where the server sent JSON).
    data: string,
    method: push-method,
    /// The call it arrived with, for INVITE and INFO pushes (e.g.,
    /// `digium.incomingCall.voicemail`); the app may answer or reject it.
    /// A call whose event the configuration gives to apps does not ring
    /// and has no call screen; it ends when the apps that got this push
    /// have left the screen or stopped.
    call: option<call-id>,
  }

  variant event {
    /// The app is on screen.
    foreground,
    /// The app left the screen (it keeps running unless it asked to exit).
    background,
    /// Last event before the instance is dropped.
    exit,
    /// The app's idle window came on screen: the idle screen is the top
    /// screen and it is this app's turn (apps with idle windows take
    /// turns).
    idle-screen-show,
    /// The app's idle window left the screen.
    idle-screen-hide,
    /// A key claimed with `ui.claim-keys`, or any key under
    /// `input.capture`.
    key(key),
    /// The handset was lifted (`true`) or put back (under
    /// `input.capture`).
    hook(bool),
    softkey(u32),
    widget(tuple<widget, widget-event>),
    /// A finger on a widget that takes touches (`ui.claim-touch`), on a
    /// phone with a touchscreen.
    touch(tuple<widget, touch>),
    timer(timer-id),
    /// The result of a `pbx` request.
    pbx(tuple<request-id, result<pbx-result, pbx-error>>),
    http(tuple<request-id, result<http-response, string>>),
    /// A call changed (after `calls.observe(true)`): its state or the
    /// remote party's name or number.  The end of a call arrives once,
    /// with the state `ended`.
    call(call-info),
    push(push),
    /// The message counts of an account changed.  For every app that
    /// uses `calls`, without asking.
    mwi(mwi),
    /// A target the app observes (`presence.observe`) changed.
    presence(presence),
    /// New merged configuration; re-read `config`.
    new-config,
    /// An account registered with its other host (failover to the
    /// alternate, or back).
    server-change,
    /// The sound started with `audio.play` played to its end, was
    /// stopped, or was cut off by the ringer; position in the sound in
    /// seconds.
    playback-stopped(u32),
    /// An event from another app or the phone, addressed to this app.
    message(tuple<string, string>),
    /// The outcome of a `storage` request to a PBX location.
    storage(tuple<request-id, storage-outcome>),
    /// Another phone set or removed a `pbx-shared` key of this app (after
    /// `storage.watch(true)`).
    storage-changed(storage-change),
    /// The PBX locations of `storage` can be reached (again): requests
    /// that ended `unreachable` are worth another try, and what the app
    /// read there before may have changed since.
    storage-online,
    /// The phone's alarm clock changed: an alarm was set, changed, or
    /// removed (from this app, another, or the web interface), rang, or
    /// was snoozed or dismissed.  For apps that use `alarms`.
    alarms-changed,
    /// How the `hotdesk.login` or `hotdesk.logout` this app called
    /// ended: the phone has the configuration asked for, or the reason
    /// the PBX or the phone gave against it (e.g., a wrong PIN), after
    /// which the phone is assigned as it was before.
    hotdesk-done(result<_, string>),
  }
}

/// Lifecycle requests and logging.  Always available.
interface runtime {
  /// Leave the screen.
  background: func();
  /// Stop the app after the current handler returns.
  exit: func();
  /// Restart the app (fresh instance).
  restart: func();
  /// Keep running when backgrounded (stock `exitAfterBackground = false`).
  set-exit-after-background: func(exit: bool);
  /// Show another app, after the current handler returns.  Fails when
  /// the phone has no app of that name, or the configuration switches
  /// the app off.
  show-app: func(name: string) -> result<_, string>;
  /// Count as user activity: wakes the backlight and restarts its
  /// timeout.  Has an effect only while the app is on screen.
  reset-idle-timer: func();
  /// 0 error, 1 warn, 2 info, 3 debug.
  log: func(level: u8, message: string);
  in-foreground: func() -> bool;
  /// 64 random bits from the phone's random source, e.g., to seed a
  /// game's generator.
  random: func() -> u64;
}

/// Widgets and softkeys.  Capability `ui`.
interface ui {
  use types.{widget, widget-kind, rect, size, metrics, align, font, input-mode, list-item, softkey, error, image, key};

  get-metrics: func() -> metrics;
  /// Size of the idle-screen area offered to apps with `hasIdle`.
  idle-size: func() -> size;
  /// The idle window's root widget (apps with `hasIdle` only).
  idle-root: func() -> option<widget>;

  create: func(kind: widget-kind, parent: widget, bounds: rect) -> widget;
  /// Destroys the widget and its children.
  destroy: func(w: widget);
  /// Destroys every child of the widget.
  clear: func(w: widget);
  set-bounds: func(w: widget, bounds: rect);
  /// Shows or hides the widget and its children.  Hiding the focused
  /// widget, or a widget the focused one is in, leaves no widget focused.
  set-visible: func(w: widget, visible: bool);
  set-focus: func(w: widget);

  set-text: func(w: widget, text: string);
  set-align: func(w: widget, align: align);
  set-font: func(w: widget, font: font);
  /// Wrap long text onto several lines (text widgets).
  set-wrap: func(w: widget, wrap: bool);
  /// Draw the widget in the skin's selection colors, as a list draws its
  /// selected row (e.g., one cell of a grid of texts).
  set-highlight: func(w: widget, on: bool);

  set-items: func(w: widget, items: list<list-item>);
  set-selected: func(w: widget, index: u32);
  /// The highlighted row of a list; `none` for a list without rows, a
  /// widget of another kind, and a widget that no longer exists.
  selected: func(w: widget) -> option<u32>;

  set-value: func(w: widget, value: string);
  value: func(w: widget) -> string;
  set-input-mode: func(w: widget, mode: input-mode);
  set-max-length: func(w: widget, max: u32);

  /// Gives a picture of the app's a name, for `image.picture` (in
  /// `set-image` and in list items): `png` is a PNG file's content, which
  /// the app holds in its data (e.g., with `include_bytes!`).  At most 512 KiB
  /// and 1,048,576 pixels a picture, and 32 pictures.  Content that is
  /// not a PNG picture the phone can show is refused (`invalid`).
  /// Defining a name again replaces the picture.
  define-image: func(name: string, png: list<u8>) -> result<_, error>;

  /// Shows a picture in an image widget.  A picture name the app did not
  /// define shows nothing.
  set-image: func(w: widget, image: image);

  /// Keys this widget wants as `event.key` instead of the built-in
  /// behavior.  For each press the phone walks from the focused widget up
  /// to the root (widget 0, the window); the first claimant gets the key.
  /// An unclaimed `cancel` backgrounds the app.
  claim-keys: func(w: widget, keys: list<key>);

  /// With `true`, what a finger does on this widget comes as
  /// `event.touch` instead of the built-in behavior, with places counted
  /// from the widget's top-left corner (widget 0: the window's).  A
  /// touch goes to the widget the finger came down on, or else to the
  /// nearest widget around that one, that takes touches; the softkeys
  /// and the back button are not the app's.  A touch no widget takes has
  /// the built-in behavior: touching a list's row highlights and
  /// activates it (`highlighted`, if it was not, then `activated`), a
  /// drag scrolls a list or a scroll widget, and touching an input
  /// focuses it.  Only a phone with a touchscreen (the `touch` skin) has
  /// touches; elsewhere this does nothing.
  claim-touch: func(w: widget, on: bool);

  /// Gives the app's window the whole display (`true`), or the usual
  /// area above the softkey bar again.  A full-screen window has no
  /// softkey bar: softkeys are not shown, and the four keys under the
  /// display do nothing unless the app claims them (`key.softkey`).
  /// `get-metrics` reports the size the window now has (480x272, 320x160,
  /// 240x120, or 800x1280 when full-screen); widgets keep their bounds.  An
  /// unclaimed `cancel` still leaves the app and line key 1 always does,
  /// and a call or a notice of the phone comes over a full-screen window
  /// as over any other.  The idle window is not affected.
  set-full-screen: func(on: bool);

  /// Softkeys attached to a widget; the bar shows the keys of the focused
  /// widget or its nearest ancestor that has any.  More than four become a
  /// "More" page.  On the touchscreen the softkeys are buttons to touch,
  /// in the same four places.
  set-softkeys: func(w: widget, keys: list<softkey>);
}

/// Capability `timers`.
interface timers {
  use types.{timer-id, error};
  /// Starts a timer: `event.timer` arrives after `delay-ms`, and with
  /// `repeat` every `delay-ms` after that (at least 50).  An app has at
  /// most 32 timers at a time; one more is refused (`failed`).
  set: func(delay-ms: u32, repeat: bool) -> result<timer-id, error>;
  cancel: func(id: timer-id);
  /// Monotonic milliseconds.
  now-ms: func() -> u64;
  /// Seconds since the Unix epoch.
  wall-time: func() -> u64;
}

/// Capability `config`.
interface config {
  use types.{account-info, phone-model};

  /// The phone settings an app may read, by their stock ids.
  enum phone-setting {
    /// `locale`, e.g., `en_US`.
    locale,
    /// `time_zone`: an IANA name, or a POSIX TZ string.
    time-zone,
    /// `time_short_format`: a CLDR pattern, e.g., `h:mm a`.
    time-format,
    /// `date_short_format`: a CLDR pattern, e.g., `M/d/yy`.
    date-format,
    /// `contacts_max_subscriptions`: a number.
    contacts-max-subscriptions,
    /// `blf_contact_group`: a contact group's id or name.
    blf-contact-group,
    /// `default_ringtone`: a ringtone's name.
    default-ringtone,
    /// `name_format`: e.g., `first_last` or `last_first`.
    name-format,
    /// `brightness`: 0 to 10.
    brightness,
  }

  /// This app's provisioned `<appconfig>` element as XML ("" if none),
  /// without the credentials (`password` and `secret`), which the host
  /// keeps: it adds them to PBX requests.
  app-config: func() -> string;
  /// One attribute of this app's `<settings>`, else of its `<appconfig>`;
  /// `account_id` is its `<account>`'s.
  app-setting: func(name: string) -> option<string>;
  /// A phone setting, as the configuration writes it (`none` if the
  /// configuration does not set it); the time and date formats are the
  /// active locale's unless the configuration sets its own.
  setting: func(id: phone-setting) -> option<string>;
  accounts: func() -> list<account-info>;
  model: func() -> phone-model;
  firmware-version: func() -> string;
  mac-address: func() -> string;
  /// Contact-list files provisioned to the phone: (file name, XML text).
  contact-lists: func() -> list<tuple<string, string>>;
}

/// Capability `pbx`: requests to the PBX's application server (Open DPMA,
/// or the original DPMA), one function for each method the server has.
/// The phone sends a request by the transport of the app's provisioned
/// `<account>` (`dasp://` through the DPMA session, or HTTP), with the
/// account's credentials and its `account_id`.  Every function returns an
/// id at once; the result arrives as `event.pbx`.
interface pbx {
  use types.{request-id, call-id, voicemail-sort};

  /// The user's presence.  Ends `presence`.
  presence-info: func() -> request-id;
  /// The presences the user can choose.  Ends `presence-options`.
  presence-options: func() -> request-id;
  /// Sets the user's presence to an option (`pbx-presence-option.id`),
  /// with a message (may be empty).  Ends `done`.
  set-presence: func(option-id: u32, message: string) -> request-id;

  /// The parking lots and the calls parked in them.  Ends `parking-lots`.
  parking-lots: func() -> request-id;

  /// Starts recording a call of the phone into the voicemail box of the
  /// call's account (its folder `Recordings`).  Ends `done`.
  start-recording: func(call: call-id) -> request-id;
  /// Stops recording a call.  Ends `done`.
  stop-recording: func(call: call-id) -> request-id;

  /// The call queues of the phone's queue applications.  Ends `queues`.
  queues: func() -> request-id;
  /// Today's figures of a queue (`call-queue.id`).  Ends `queue-status`.
  queue-status: func(queue: string) -> request-id;
  /// Logs the user in to a queue, or, with `none`, to every queue.  Ends
  /// `done`.
  queue-login: func(queue: option<string>) -> request-id;
  /// Logs the user out, as `queue-login` logs in.  Ends `done`.
  queue-logout: func(queue: option<string>) -> request-id;
  /// Pauses the user in a queue, or in every queue, with a reason (may
  /// be empty).  Ends `done`.
  queue-pause: func(queue: option<string>, reason: string) -> request-id;
  /// Ends a pause, as `queue-pause` begins one.  Ends `done`.
  queue-resume: func(queue: option<string>) -> request-id;

  /// Adds a contact to a contact list of the phone (`phonebook`: the
  /// list's id), and provisions the phone again.  Ends `done`.
  add-contact: func(phonebook: string, extension: string, name: string) -> request-id;

  /// One page of a folder's messages, `per-page` messages to a page (at
  /// least 1), the first page 1.  Ends `voicemail`.
  voicemail-messages: func(folder: string, sort: voicemail-sort, descending: bool, per-page: u32, page: u32) -> request-id;
  /// The voicemail folders.  Ends `voicemail-folders`.
  voicemail-folders: func() -> request-id;
  /// Moves messages to another folder.  Ends `done`.
  voicemail-move: func(folder: string, target: string, messages: list<string>) -> request-id;
  /// Deletes messages.  Ends `done`.
  voicemail-remove: func(folder: string, messages: list<string>) -> request-id;
  /// Copies messages to the inbox of another account's voicemail box
  /// (the account's `id`).  Ends `done`.
  voicemail-forward: func(folder: string, account: string, messages: list<string>) -> request-id;
  /// Marks messages heard.  Ends `done`.
  voicemail-mark-read: func(folder: string, messages: list<string>) -> request-id;
  /// Marks messages new.  Ends `done`.
  voicemail-mark-unread: func(folder: string, messages: list<string>) -> request-id;
  /// Has the PBX call the phone and play a message: the call arrives as
  /// `event.push` `digium.incomingCall.voicemail`.  Ends `done`.
  voicemail-play: func(folder: string, message: string) -> request-id;

  /// Forget a request: its result is not delivered.
  cancel: func(id: request-id);
}

/// Capability `storage`: the app's keys and values, in three locations
/// (`storage-location`).  No other app can reach them.
///
/// `local` keys are on the phone.  The phone keeps them across restarts
/// and firmware updates, and deletes them when the app is removed.  A
/// key is a name of 1 to 64 bytes that does not start with `.` and has
/// no `/`, `\`, or NUL in it; a value is at most 1 MiB.  The phone
/// answers a request at once (`storage-reply.done`).
///
/// `pbx-private` and `pbx-shared` keys are on the PBX, in Open DPMA's
/// store of app data, which keeps a separate store for each of its
/// tenants.  A key is 1 to 64 characters, each a letter, a digit, or one
/// of `.`, `_`, `-`, `/`, and `:`.  A value is at most 4096 bytes.  An
/// app has at most 64 keys for each user and 1024 shared keys.  A
/// request returns an id at once (`storage-reply.pending`), and its
/// outcome arrives as `event.storage`.  A request that cannot reach the
/// PBX ends `unreachable`; the phone keeps nothing to send later, so an
/// app that must not lose what it wanted to write keeps it in `local` and
/// writes it again at `event.storage-online`.
///
/// A writer that must not undo another's write (another phone's, for
/// the PBX locations) passes `expect`, the version of the entry it read:
/// the store then writes only over that entry, and answers `conflict`
/// with the entry that is there otherwise, for the app to change and
/// write again.
interface storage {
  use types.{request-id, storage-location, storage-reply, pbx-user};
  /// The entry of a key.  Ends `entry`.
  get: func(location: storage-location, key: string) -> storage-reply;
  /// The entries whose keys start with `prefix` and come after the key
  /// `after` ("" for the first ones), in the order of their keys.  Ends
  /// `entries`, with at most 64 entries and, past the first, about 16 KiB
  /// of values; when it says there are more, ask again with the last key
  /// as `after`.
  %list: func(location: storage-location, prefix: string, after: string) -> storage-reply;
  /// Sets a key.  Without `expect`, whatever value it had is replaced.
  /// With `expect` 0, the key is set only if it is not set yet; with a
  /// version, only if its entry still has that version.  Ends `stored`
  /// or `conflict`.
  set: func(location: storage-location, key: string, value: list<u8>, expect: option<u64>) -> storage-reply;
  /// Removes a key, under the same conditions as `set`.  Ends `removed`
  /// or `conflict`.
  remove: func(location: storage-location, key: string, expect: option<u64>) -> storage-reply;
  /// Forget a request to a PBX location: its outcome is not delivered.
  cancel: func(id: request-id);
  /// With `true`, `event.storage-changed` arrives whenever another phone
  /// sets or removes a `pbx-shared` key of this app, while the app runs.
  watch: func(on: bool);
  /// Whether the PBX locations can be reached now.
  online: func() -> bool;
  /// The phone's user, once the PBX has said who it is (`none` before
  /// the PBX locations were first reached since the phone started).
  user: func() -> option<pbx-user>;
}

/// Capability `http`.
interface http {
  use types.{request-id, header};
  request: func(method: string, url: string, headers: list<header>, body: list<u8>) -> request-id;
  cancel: func(id: request-id);
}

/// Capability `calls`.  What call control refuses as not possible (no
/// such call, a call in the wrong state, a bad argument) is `invalid`;
/// what it tried and could not do is `failed`, and so is an answer that
/// does not come in time, after which the request may still be carried
/// out.
interface calls {
  use types.{call-id, call-info, error, header, mwi};
  /// `headers` (at most 30) are added to the INVITE; the headers SIP
  /// itself needs (`Via`, `From`, `Contact`, and so on) cannot be set.
  dial: func(number: string, account: option<u8>, headers: list<header>) -> result<call-id, error>;
  answer: func(call: call-id) -> result<_, error>;
  reject: func(call: call-id) -> result<_, error>;
  hangup: func(call: call-id) -> result<_, error>;
  send-dtmf: func(call: call-id, digits: string) -> result<_, error>;
  %list: func() -> list<call-info>;
  /// Deliver `event.call` for every call change.
  observe: func(on: bool);
  get-mwi: func() -> list<mwi>;
  dial-voicemail: func(account: option<u8>) -> result<_, error>;
}

/// Capability `presence`: the presence and line state of the contacts
/// the phone watches, and the presence of the phone's user.  The phone
/// watches the contacts on the rapid-dial (BLF) keys that have
/// `subscribe_to` in the contact list: the keys the configuration's
/// `blf_items` name, or, without any, the contacts of the group
/// `blf_contact_group` on the unused keys.  The phone watches at most
/// `contacts_max_subscriptions` targets (40 unless set).  A contact that
/// is on no key is not watched, and an app cannot make the phone watch
/// one.
interface presence {
  use types.{presence, presence-status, error};
  /// Have the changes of a target the phone watches arrive as
  /// `event.presence`: an extension, a contact's id, or a URI.  A target
  /// the phone does not watch is accepted and never has an event.  An
  /// app observes at most 256 targets; one more is refused (`failed`).
  observe: func(target: string) -> result<_, error>;
  stop-observing: func(target: string);
  /// What the phone knows of a target (`none`: the phone does not watch
  /// it).
  get: func(target: string) -> option<presence>;
  /// Set the presence of the phone's user (line display and SIP PUBLISH
  /// where configured).  `unknown` is refused (`invalid`).
  set-status: func(status: presence-status, text: string) -> result<_, error>;
  /// The presence of the phone's user.
  get-status: func() -> presence;
}

/// Capability `events`.
interface events {
  use types.{error};
  /// Receive pushes with this event name as `event.push`.  An app
  /// observes at most 64 names; one more is refused (`failed`).
  observe: func(name: string) -> result<_, error>;
  stop-observing: func(name: string);
  /// Send `event.message(name, payload)` to another running app, after
  /// the current handler returns.  Fails when no app of that name is
  /// running.
  send: func(app: string, name: string, payload: string) -> result<_, string>;
}

/// Capability `audio`.
interface audio {
  use types.{error};
  /// Play a sound the app holds in its data (e.g., with
  /// `include_bytes!`), from `start` seconds: `sound` is the content of a
  /// sound file, either headerless 16 kHz mono signed 16-bit
  /// little-endian samples (stock `.sln16`) or a WAVE file (PCM, mu-law,
  /// or A-law).  At most five minutes.  The phone plays one sound at a
  /// time: a new sound replaces the one that plays, whichever app
  /// started it, and that app gets `event.playback-stopped`.
  /// `event.playback-stopped` follows when the sound is over.
  play: func(sound: list<u8>, start: u32) -> result<_, error>;
  /// Stops the sound this app started with `play`, if it still plays.
  /// Another app's sound and a ringtone preview play on.
  stop: func();
}

/// Capability `l10n`.
interface l10n {
  /// Current locale (`en_US` for now).
  locale: func() -> string;
  /// Words of the phone's softkeys and screens.
  enum common-text { ok, cancel, back, exit, select, yes, no, more, delete, save, loading, error }
  /// A common word in the phone's language.
  common: func(key: common-text) -> string;
  /// What `format-time` writes.
  enum time-style { time, date, date-and-time }
  /// Local date and time text for a Unix time.  The time follows the
  /// phone's 12- or 24-hour setting; the date is written as `Nov 13,
  /// 2026` whatever the phone's date format setting says.
  format-time: func(unix: u64, style: time-style) -> string;
  /// Offset of local time from UTC now, in seconds (east is positive).
  utc-offset: func() -> s32;
}

/// Capability `hotdesk`: change which user this phone is provisioned for.
interface hotdesk {
  use types.{error};
  /// Log a user in with their extension and PIN.  `ok` says only that
  /// the phone has begun to ask the PBX; how the login ended arrives as
  /// `event.hotdesk-done`.
  login: func(extension: string, pin: string) -> result<_, error>;
  /// Return the phone to its unassigned configuration.  `ok` and
  /// `event.hotdesk-done` as for `login`.
  logout: func() -> result<_, error>;
  /// The user the phone is assigned to ("" if none).
  current-user: func() -> string;
}

/// Capability `diagnostics`: the state of the phone.
interface diagnostics {
  enum subsystem { core, configuration, network, sip, media, dpma, ui, apps, web, ssh, update }

  /// The state of a subsystem; the text says why.
  variant health-state { ok, starting, stopped, degraded(string), failed(string) }

  record subsystem-health {
    subsystem: subsystem,
    health: health-state,
  }

  /// Every subsystem of the phone and its state.
  health: func() -> list<subsystem-health>;
  /// The newest log entries, newest first, at most `max` of them (and at
  /// most 100): `<source> <message>`.
  log-tail: func(max: u32) -> list<string>;
}

/// Capability `lamps`: the phone's lamps.  What an app sets holds while
/// the app's window is on screen: under a call or another screen, and
/// when the app has left, exited, or failed, every lamp shows what the
/// phone shows there.
interface lamps {
  enum color { off, red, green, amber }

  variant lamp {
    /// The lamp of a line key, from 1 at the top.
    line(u8),
    /// The lamp of a rapid-dial key, from 1 at the top.
    blf(u8),
    /// Message waiting.
    message,
    mute,
    headset,
    speaker,
  }

  /// The lamps of this phone.
  %list: func() -> list<lamp>;
  /// Shows a color on a lamp in place of what the phone shows there.  A
  /// lamp this phone does not have is ignored, and so is a color a lamp
  /// does not have.
  set: func(lamp: lamp, color: color);
  /// Gives every lamp back to the phone.
  release: func();
}

/// Capability `input`: every key and the hookswitch.
interface input {
  /// With `true`, every key press comes to the app as `event.key` while
  /// the app's window is on screen, and every change of the hookswitch
  /// as `event.hook`: also the keys an app's window never gets otherwise
  /// (line key 1, the volume keys, `mute`, `speaker`, and `headset`), the
  /// softkeys, and the keys a widget would use.  The phone itself does
  /// nothing with them: no volume change, no softkey, and no dial tone
  /// when the handset is lifted.  With `false`, keys go the usual
  /// way again.
  ///
  /// The user can always leave: `cancel` three times in a row leaves the
  /// app (the first two come to the app).  A call or a notice of the
  /// phone comes over the app's window as over any other and has the
  /// keys while it shows.
  capture: func(on: bool);
}

/// Capability `canvas`: free drawing, for what the widgets cannot show
/// (a game, a chart).  A canvas is a widget (`ui` places, hides, and
/// destroys it) that shows a list of drawing operations; `draw` replaces
/// the whole list in one call, so the phone never paints half a picture.
/// The phone repaints from the list whenever it needs to and sends its
/// panel only the part of the screen that changed.  There is no sound and
/// no faster clock here: an app animates with a repeating timer, which
/// fires at most 20 times a second.
interface canvas {
  use types.{widget, rect, size, font};

  /// The colors of the phone's skin.
  enum role {
    background,
    foreground,
    /// The selection colors (a list's selected row).
    highlight,
    highlight-text,
    title-background,
    title-text,
    secondary,
    border,
  }

  /// Red, green, and blue.  The gray skins show the nearest of their four
  /// levels (black, dark gray, light gray, white) by brightness.
  record color { r: u8, g: u8, b: u8 }

  /// A picture of one color: one bit per pixel, rows from the top, each
  /// row padded to whole bytes, the leftmost pixel in the highest bit.
  /// Set bits are painted; clear bits leave what is underneath.
  record bitmap {
    x: s16,
    y: s16,
    /// In pixels of the picture, each at most 256.
    width: u16,
    height: u16,
    /// Each pixel is drawn as a square with this side (1 to 8).
    scale: u8,
    color: color,
    bits: list<u8>,
  }

  /// One line of text in a font of the skin (the fonts of `ui.set-font`:
  /// smoothed on the color models, bitmap fonts on the gray ones), in
  /// one color.  The text is placed so that what its glyphs paint is in
  /// the middle of the box, both ways (not the line: a digit sits in the
  /// middle of a square), and nothing is drawn outside the box.
  /// `text-size` tells what a text needs, to choose a font that fits.
  record text {
    box: rect,
    font: font,
    color: color,
    /// At most 64 bytes.
    text: string,
  }

  variant op {
    /// A filled rectangle.
    fill(tuple<rect, color>),
    bitmap(bitmap),
    text(text),
  }

  /// A color of the skin, so that a drawing can match it.
  theme-color: func(role: role) -> color;
  /// The width and height of what a text paints in a font of the skin
  /// (the pixels of its glyphs, without the space around a line).
  text-size: func(font: font, text: string) -> size;
  /// Creates a canvas widget (parent 0 is the window).  Coordinates of
  /// its operations are relative to its top-left corner, and nothing is
  /// drawn outside it.
  create: func(parent: widget, bounds: rect) -> widget;
  /// Replaces what the canvas shows.  At most 512 operations, 64 KiB of
  /// bitmap data, and 64 bytes in a text; a list over a limit is refused
  /// and the canvas keeps what it showed.  A widget that is not a canvas
  /// (or no longer exists) is refused too.
  draw: func(w: widget, ops: list<op>) -> result<_, string>;
}

/// Capability `alarms`: the phone's alarm clock.  The phone keeps the
/// alarms and rings them, whether or not any app runs: when an alarm is
/// due it sounds the alarm's tone and shows the alarm with Snooze and
/// Dismiss over whatever is on screen.  An app that uses this interface
/// shows the alarms and changes them; `event.alarms-changed` tells it when
/// they changed.
interface alarms {
  use types.{error};

  record alarm {
    /// Identifies the alarm.  0 in `set` adds an alarm.
    id: u32,
    /// The time of day, in the phone's time zone.
    hour: u8,
    minute: u8,
    /// The days of the week it rings on: bit 0 is Sunday, bit 6
    /// Saturday.  0 is a one-time alarm: it rings the next time the
    /// clock shows its time, and is then switched off.
    days: u8,
    /// The alarm tone it rings with, one of `tones`.  Empty in `set`: the
    /// phone's first.
    tone: string,
    /// An alarm that is switched off does not ring.
    enabled: bool,
  }

  /// The alarms, in the order they were added.
  %list: func() -> list<alarm>;
  /// Adds an alarm (`id` 0) or changes the one with that `id`; returns
  /// its `id`.  An alarm that is changed counts from now: its time
  /// earlier today is not due until tomorrow.  The phone keeps at most
  /// 16 alarms.
  set: func(a: alarm) -> result<u32, error>;
  remove: func(id: u32) -> result<_, error>;
  /// The tones an alarm can ring with: the alarm clock's own, which are
  /// not the phone's ringtones.
  tones: func() -> list<string>;
  /// Sounds an alarm tone for a few seconds, for choosing one (`none`:
  /// stops the preview this app started, if it still sounds).
  preview: func(tone: option<string>);
  /// The next time an alarm rings: the alarm's `id` and the time, in
  /// seconds since the Unix epoch.  A snoozed alarm counts.
  next: func() -> option<tuple<u32, u64>>;
  /// The snoozed alarm, if one is: its `id`, and when it rings again.
  snoozed: func() -> option<tuple<u32, u64>>;
  /// Ends the alarm that is ringing or snoozed.
  dismiss: func() -> result<_, error>;
}

interface guest {
  use types.{event};
  /// Called once after instantiation.
  start: func();
  handle: func(e: event);
}

world app {
  import runtime;
  import ui;
  import timers;
  import storage;
  import config;
  import pbx;
  import http;
  import calls;
  import presence;
  import events;
  import audio;
  import l10n;
  import hotdesk;
  import diagnostics;
  import lamps;
  import input;
  import canvas;
  import alarms;
  export guest;
}
