---
// The homepage's phone turntable: src/scripts/turntable.ts draws the phones
// (public/phones/, built by tools/phone-models) in the box.
const models = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}phones/`;
---

<div
  class="phone-turntable"
  data-models={models}
  role="img"
  aria-label="Digium D40, D50, D60, D65, D70, and D80 desk phones running Open Desk Phone, turning one after another"
>
</div>

<script>
  import "../scripts/turntable.ts";
</script>

<style>
  .phone-turntable {
    display: block;
    position: relative;
    max-width: 822px;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
    line-height: 0;
  }

  .phone-turntable :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
